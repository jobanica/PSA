# ---- Frontend (Vite) — safe to expose, these are public anon values ----
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Edge Function secrets (set with: supabase secrets set KEY=value) ----
# NEVER put these in the frontend / .env used by Vite.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8
# SMS_PROVIDER=mock            # mock | semaphore | twilio
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# CRON_SECRET=change-me-to-a-long-random-string
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
